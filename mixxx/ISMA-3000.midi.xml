<?xml version="1.0" encoding="utf-8"?>
<!--
  ISMA 3000 — Mixxx mapping.

  Binds MIDI messages emitted by firmware/src/main.cpp to Mixxx control keys.
  What the firmware emits (pin -> note/CC) lives in main.cpp; this file only
  binds those messages to Mixxx controls — don't restate the firmware's
  emission list here or it goes stale.

  Mixxx matches this file to the device by <controller id="..."> below — must
  equal the USB product string set via USB_PRODUCT in platformio.ini.

  Docs:
    https://github.com/mixxxdj/mixxx/wiki/Midi-Controller-Mapping-File-Format
    https://manual.mixxx.org/2.4/en/chapters/controlling_mixxx.html
-->
<MixxxControllerPreset mixxxVersion="2.4" schemaVersion="1">
    <info>
        <name>ISMA 3000</name>
        <author>ismail</author>
        <description>v0 mapping — deck B only: play, sync, loop in/out/exit, hotcue 1–4, tempo, jog wheel.</description>
    </info>
    <controller id="ISMA 3000">
        <controls>
            <!-- Deck B buttons (MCP23017 port B: B2–B7, port A: A4–A7) -->
            <control>
                <group>[Channel2]</group>
                <key>play</key>
                <status>0x91</status>
                <midino>0x24</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>sync_enabled</key>
                <status>0x91</status>
                <midino>0x25</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>loop_in</key>
                <status>0x91</status>
                <midino>0x26</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>loop_out</key>
                <status>0x91</status>
                <midino>0x27</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>reloop_toggle</key>
                <status>0x91</status>
                <midino>0x28</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>hotcue_1_activate</key>
                <status>0x91</status>
                <midino>0x30</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>hotcue_2_activate</key>
                <status>0x91</status>
                <midino>0x31</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>hotcue_3_activate</key>
                <status>0x91</status>
                <midino>0x32</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>hotcue_4_activate</key>
                <status>0x91</status>
                <midino>0x33</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <!-- Deck B jog wheel (CD4067 C0 phase A + C1 phase B); relative encoder: 63=CW, 65=CCW -->
            <control>
                <group>[Channel2]</group>
                <key>jog</key>
                <status>0xB1</status>
                <midino>0x16</midino>
                <options>
                    <SelectKnob/>
                </options>
            </control>
        </controls>
        <outputs>
        </outputs>
    </controller>
</MixxxControllerPreset>
