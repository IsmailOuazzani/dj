<?xml version="1.0" encoding="utf-8"?>
<!--
  ISMA 3000 — Mixxx mapping.

  Binds MIDI messages emitted by firmware/src/main.cpp to Mixxx control keys.
  What the firmware emits (pin -> note/CC) lives in main.cpp; this file only
  binds those messages to Mixxx controls — don't restate the firmware's
  emission list here or it goes stale.

  Mixxx matches this file to the device by <controller id="..."> below — must
  equal the USB product string set via USB_PRODUCT in platformio.ini.

  Docs:
    https://github.com/mixxxdj/mixxx/wiki/Midi-Controller-Mapping-File-Format
    https://manual.mixxx.org/2.4/en/chapters/controlling_mixxx.html
-->
<MixxxControllerPreset mixxxVersion="2.4" schemaVersion="1">
    <info>
        <name>ISMA 3000</name>
        <author>ismail</author>
        <description>v0 mapping: play/pause + main filter (QuickEffect super) + channel volume on both decks.</description>
    </info>
    <controller id="ISMA 3000">
        <controls>
            <control>
                <group>[QuickEffectRack1_[Channel1]]</group>
                <key>super1</key>
                <status>0xB0</status>
                <midino>0x07</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[QuickEffectRack1_[Channel2]]</group>
                <key>super1</key>
                <status>0xB1</status>
                <midino>0x07</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>volume</key>
                <status>0xB0</status>
                <midino>0x14</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>volume</key>
                <status>0xB1</status>
                <midino>0x14</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>play</key>
                <status>0x90</status>
                <midino>0x24</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>play</key>
                <status>0x91</status>
                <midino>0x24</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>sync_enabled</key>
                <status>0x90</status>
                <midino>0x25</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>hotcue_1_activate</key>
                <status>0x90</status>
                <midino>0x30</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>rate</key>
                <status>0xB0</status>
                <midino>0x15</midino>
                <options>
                    <Normal/>
                </options>
            </control>
        </controls>
        <outputs>
        </outputs>
    </controller>
</MixxxControllerPreset>
