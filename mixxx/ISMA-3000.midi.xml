<?xml version="1.0" encoding="utf-8"?>
<!--
  ISMA 3000 — v0 validation mapping.

  Covers the 4 controls currently wired on breadboard: play/pause and the
  main filter (Mixxx QuickEffect super knob) on each of the 2 decks.
  Firmware (firmware/src/main.cpp) reads two pots through a CD74HC4067 mux
  (channels Y0/Y1) and two buttons through a MCP23017 I²C expander
  (GPA0/GPA1), then emits:

      Deck A filter : CC 7  on MIDI channel 1  (status 0xB0)
      Deck B filter : CC 7  on MIDI channel 2  (status 0xB1)
      Deck A play   : Note 0x24 on channel 1   (status 0x90) — NoteOn on press only
      Deck B play   : Note 0x24 on channel 2   (status 0x91) — NoteOn on press only

  Values are 0..127 (12-bit ADC scaled down to 7 bits for the pots, 127 for
  the button press).

  Mixxx matches a mapping to a connected device by the <controller id="..."> attribute
  below — it must equal the USB product string the device advertises. The firmware
  sets USB_PRODUCT="ISMA 3000" via build_flags in platformio.ini.

  Docs used while authoring:
    https://github.com/mixxxdj/mixxx/wiki/Midi-Controller-Mapping-File-Format
    https://github.com/mixxxdj/mixxx/wiki/Contributing-Mappings
    https://github.com/mixxxdj/mixxx/wiki/Controller-Mapping-File-Locations
    https://manual.mixxx.org/2.4/en/chapters/controlling_mixxx.html
-->
<MixxxControllerPreset mixxxVersion="2.4" schemaVersion="1">
    <info>
        <name>ISMA 3000</name>
        <author>ismail</author>
        <description>v0 mapping: play/pause + main filter (QuickEffect super) on both decks.</description>
    </info>
    <controller id="ISMA 3000">
        <controls>
            <control>
                <group>[QuickEffectRack1_[Channel1]]</group>
                <key>super1</key>
                <status>0xB0</status>
                <midino>0x07</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[QuickEffectRack1_[Channel2]]</group>
                <key>super1</key>
                <status>0xB1</status>
                <midino>0x07</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>play</key>
                <status>0x90</status>
                <midino>0x24</midino>
                <options>
                    <Button/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>play</key>
                <status>0x91</status>
                <midino>0x24</midino>
                <options>
                    <Button/>
                </options>
            </control>
        </controls>
        <outputs>
        </outputs>
    </controller>
</MixxxControllerPreset>
