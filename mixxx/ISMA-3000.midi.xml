<?xml version="1.0" encoding="utf-8"?>
<!--
  ISMA 3000 — Mixxx mapping.

  Binds MIDI messages emitted by firmware/src/main.cpp to Mixxx control keys.
  What the firmware emits (pin -> note/CC) lives in main.cpp; this file only
  binds those messages to Mixxx controls — don't restate the firmware's
  emission list here or it goes stale.

  Mixxx matches this file to the device by <controller id="..."> below — must
  equal the USB product string set via USB_PRODUCT in platformio.ini.

  Docs:
    https://github.com/mixxxdj/mixxx/wiki/Midi-Controller-Mapping-File-Format
    https://manual.mixxx.org/2.4/en/chapters/controlling_mixxx.html
-->
<MixxxControllerPreset mixxxVersion="2.4" schemaVersion="1">
    <info>
        <name>ISMA 3000</name>
        <author>ismail</author>
        <description>v0 mapping — buttons: deck A start/sync/loop in-out-toggle/hotcue 1–4, deck B play/sync/loop in-out-exit/hotcue 1–4. Shift+hotcue clears the cue; shift+jog fast-seeks. Pots: crossfader, per-deck volume/filter/bass/mid, FX knob. No gain/trim or tempo pots. Deck A/B jog wheels via scratch1/scratch2.</description>
    </info>
    <controller id="ISMA 3000">
        <scriptfiles>
            <file filename="ISMA-3000.scripts.js" functionprefix="ISMA3000"/>
        </scriptfiles>
        <controls>
            <!-- Deck B buttons (MCP23017 port B: B2–B7, port A: A4–A7) -->
            <control>
                <group>[Channel2]</group>
                <key>play</key>
                <status>0x91</status>
                <midino>0x24</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>sync_enabled</key>
                <status>0x91</status>
                <midino>0x25</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>loop_in</key>
                <status>0x91</status>
                <midino>0x26</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>loop_out</key>
                <status>0x91</status>
                <midino>0x27</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <!-- Matches Pioneer DDJ-400 RELOOP/EXIT: one button toggles the loop off/on
                 based on current state. Pairs cleanly with loop_in (0x26) + loop_out (0x27). -->
            <control>
                <group>[Channel2]</group>
                <key>reloop_toggle</key>
                <status>0x91</status>
                <midino>0x28</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <!-- Hotcues are Script-Bindings (not plain hotcue_N_activate) so
                 shift+pad can clear instead of activate — see ISMA3000.hotcue
                 in ISMA-3000.scripts.js. -->
            <control>
                <group>[Channel2]</group>
                <key>ISMA3000.hotcue1B</key>
                <status>0x91</status>
                <midino>0x30</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>ISMA3000.hotcue2B</key>
                <status>0x91</status>
                <midino>0x31</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>ISMA3000.hotcue3B</key>
                <status>0x91</status>
                <midino>0x32</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>ISMA3000.hotcue4B</key>
                <status>0x91</status>
                <midino>0x33</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <!-- Deck A buttons (MCP23017 at 0x21 — port B: B3–B7, port A: A3–A7).
                 Same note numbers as deck B, mirrored onto MIDI channel 1 (status 0x90). -->
            <control>
                <group>[Channel1]</group>
                <key>play</key>
                <status>0x90</status>
                <midino>0x24</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>sync_enabled</key>
                <status>0x90</status>
                <midino>0x25</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>loop_in</key>
                <status>0x90</status>
                <midino>0x26</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>loop_out</key>
                <status>0x90</status>
                <midino>0x27</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>reloop_toggle</key>
                <status>0x90</status>
                <midino>0x28</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>ISMA3000.hotcue1A</key>
                <status>0x90</status>
                <midino>0x30</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>ISMA3000.hotcue2A</key>
                <status>0x90</status>
                <midino>0x31</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>ISMA3000.hotcue3A</key>
                <status>0x90</status>
                <midino>0x32</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>ISMA3000.hotcue4A</key>
                <status>0x90</status>
                <midino>0x33</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <!-- Shift buttons — plain momentary presses on their own MCP pad (note
                 0x29), tracked in script as ISMA3000.shift[1|2] rather than bound to
                 a Mixxx control. Consulted by the hotcue and jog handlers above/below. -->
            <control>
                <group>[Channel1]</group>
                <key>ISMA3000.shiftA</key>
                <status>0x90</status>
                <midino>0x29</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>ISMA3000.shiftB</key>
                <status>0x91</status>
                <midino>0x29</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <!-- Pots on the CD74HC4067 mux ("red board"). Absolute 7-bit CCs.
                 Deck A = status 0xB0 (ch 1), deck B = 0xB1 (ch 2).
                 Crossfader + FX knob are global and ride ch 1 on their own CCs.
                 No tempo/rate or gain/trim (pregain) pots — removed entirely,
                 no CC or mux channel assigned to either. -->
            <control>
                <group>[Master]</group>
                <key>crossfader</key>
                <status>0xB0</status>
                <midino>0x19</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel1]</group>
                <key>volume</key>
                <status>0xB0</status>
                <midino>0x14</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>volume</key>
                <status>0xB1</status>
                <midino>0x14</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[QuickEffectRack1_[Channel1]]</group>
                <key>super1</key>
                <status>0xB0</status>
                <midino>0x07</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[QuickEffectRack1_[Channel2]]</group>
                <key>super1</key>
                <status>0xB1</status>
                <midino>0x07</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[EqualizerRack1_[Channel1]_Effect1]</group>
                <key>parameter1</key>
                <status>0xB0</status>
                <midino>0x17</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[EqualizerRack1_[Channel2]_Effect1]</group>
                <key>parameter1</key>
                <status>0xB1</status>
                <midino>0x17</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <!-- Mid EQ — new pots on mux channels 6 (deck A) / 5 (deck B), CC 0x1B (27). -->
            <control>
                <group>[EqualizerRack1_[Channel1]_Effect1]</group>
                <key>parameter2</key>
                <status>0xB0</status>
                <midino>0x1B</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[EqualizerRack1_[Channel2]_Effect1]</group>
                <key>parameter2</key>
                <status>0xB1</status>
                <midino>0x1B</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <control>
                <group>[EffectRack1_EffectUnit1]</group>
                <key>super1</key>
                <status>0xB0</status>
                <midino>0x1A</midino>
                <options>
                    <Normal/>
                </options>
            </control>
            <!-- Deck A/B jog wheels — rotary encoders on Nano D7/D6 (deck A) and D8/D9 (deck B);
                 two's-complement relative. Routed through ISMA3000.jogA/jogB in
                 ISMA-3000.scripts.js to drive scratch1/scratch2 (visible waveform scrub)
                 instead of the built-in `jog` control (pitch bend only, invisible when paused).
                 Shift+jog fast-seeks instead of scratching — see ISMA3000.jogTick. -->
            <control>
                <group>[Channel1]</group>
                <key>ISMA3000.jogA</key>
                <status>0xB0</status>
                <midino>0x16</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
            <control>
                <group>[Channel2]</group>
                <key>ISMA3000.jogB</key>
                <status>0xB1</status>
                <midino>0x16</midino>
                <options>
                    <Script-Binding/>
                </options>
            </control>
        </controls>
        <outputs>
        </outputs>
    </controller>
</MixxxControllerPreset>
