#!/usr/bin/env bash
# Install firmware dev dependencies.
# Supports Homebrew (macOS/Linux) and Ubuntu/Debian (apt + pip).
# Idempotent: safe to re-run.

set -euo pipefail

# ---------------------------------------------------------------------------
# Platform detection
# ---------------------------------------------------------------------------
if command -v brew >/dev/null 2>&1; then
  PLATFORM="brew"
elif command -v apt-get >/dev/null 2>&1; then
  PLATFORM="ubuntu"
else
  echo "error: Neither Homebrew nor apt found. Install one and re-run." >&2
  exit 1
fi

echo "platform: $PLATFORM"
echo

# ---------------------------------------------------------------------------
# PlatformIO
# ---------------------------------------------------------------------------
if command -v pio >/dev/null 2>&1; then
  echo "ok: platformio already installed"
elif [[ "$PLATFORM" == "brew" ]]; then
  echo "installing platformio..."
  brew install platformio
else
  echo "installing platformio..."
  pip3 install --upgrade platformio
fi

# ---------------------------------------------------------------------------
# go-task
# ---------------------------------------------------------------------------
if command -v task >/dev/null 2>&1; then
  echo "ok: go-task already installed"
elif [[ "$PLATFORM" == "brew" ]]; then
  echo "installing go-task..."
  brew install go-task
else
  echo "installing go-task..."
  # Official binary installer — puts `task` in ~/.local/bin
  mkdir -p "$HOME/.local/bin"
  sh -c "$(curl -fsSL https://taskfile.dev/install.sh)" -- -d -b "$HOME/.local/bin"
  export PATH="$HOME/.local/bin:$PATH"
fi

echo
echo "versions:"
pio --version
task --version

# ---------------------------------------------------------------------------
# Mixxx mapping copy
#
# Mixxx on macOS is sandboxed (org.mixxx.mixxx) and *cannot* follow symlinks
# that point outside its container — confirmed by "Could not open xml file"
# entries in mixxx.log when we tried `ln -s`. So we copy the file instead.
# Re-running this script (or `task mixxx:sync`) refreshes the copy after the
# in-repo file is edited.
#
# Controller dirs by platform:
#   macOS (sandboxed): ~/Library/Containers/org.mixxx.mixxx/Data/Library/Application Support/Mixxx/controllers
#   Linux:             ~/.mixxx/controllers
#
# Docs:
#   https://github.com/mixxxdj/mixxx/wiki/Controller-Mapping-File-Locations
# ---------------------------------------------------------------------------
echo
echo "syncing Mixxx mapping..."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MAPPING_SRC="$REPO_ROOT/mixxx/ISMA-3000.midi.xml"

if [[ "$(uname)" == "Darwin" ]]; then
  MIXXX_DIR="$HOME/Library/Containers/org.mixxx.mixxx/Data/Library/Application Support/Mixxx/controllers"
else
  MIXXX_DIR="$HOME/.mixxx/controllers"
fi

MAPPING_DST="$MIXXX_DIR/ISMA-3000.midi.xml"

if [[ ! -f "$MAPPING_SRC" ]]; then
  echo "error: mapping source not found at $MAPPING_SRC" >&2
  exit 1
fi

mkdir -p "$MIXXX_DIR"

# Stale symlink from the old setup script — remove it.
if [[ -L "$MAPPING_DST" ]]; then
  rm "$MAPPING_DST"
fi

if [[ -f "$MAPPING_DST" ]] && cmp -s "$MAPPING_SRC" "$MAPPING_DST"; then
  echo "ok: $MAPPING_DST already up to date"
else
  cp "$MAPPING_SRC" "$MAPPING_DST"
  echo "copied $MAPPING_SRC"
  echo "    -> $MAPPING_DST"
fi

echo
echo "done."
