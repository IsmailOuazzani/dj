#!/usr/bin/env bash
# Install firmware dev dependencies via Homebrew.
# Idempotent: safe to re-run.

set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
  echo "error: Homebrew not found. Install from https://brew.sh and re-run." >&2
  exit 1
fi

FORMULAE=(
  platformio   # PlatformIO Core — build/upload/monitor toolchain
  go-task      # task runner used by Taskfile.yml
)

for formula in "${FORMULAE[@]}"; do
  if brew list --formula "$formula" >/dev/null 2>&1; then
    echo "ok: $formula already installed"
  else
    echo "installing $formula..."
    brew install "$formula"
  fi
done

echo
echo "done. versions:"
pio --version
task --version
